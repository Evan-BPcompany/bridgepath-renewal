{
  "name": "bridge-path-mvp",
  "version": "0.1.0",
  "description": "Bridge Path MVP - Manufacturer OEM/ODM Quote Platform",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "db:migrate": "knex migrate:latest --env development",
    "db:rollback": "knex migrate:rollback --env development",
    "db:migrate:make": "knex migrate:make",
    "db:seed": "knex seed:run --env development",
    "admin:bootstrap": "node scripts/admin-bootstrap.js",
    "audit:prod": "npm audit --omit=dev",
    "audit:dev": "npm audit --audit-level=high",
    "secret-scan": "node scripts/secret-scan.js",
    "it:schemas": "node dist/scripts/integration-schemas.js",
    "predeploy:check": "node dist/scripts/predeploy-check.js",
    "front:files": "node scripts/front-files.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@aws-sdk/client-s3": "^3.1143.0",
    "@sendgrid/mail": "^8.1.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "ajv": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.10.0",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.14",
    "@types/express": "^4.17.17",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "knex": "^3.1.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  }
}
