NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# There is no default database: knex and scripts/setup-db.sh stop when this is not set.
DATABASE_URL=postgresql://user:password@localhost:5432/bridgepath_dev

# TLS for the application database. Default: on in production, off elsewhere.
# DATABASE_SSL=false is refused when NODE_ENV=production, and so are sslmode/ssl parameters
# inside DATABASE_URL in production (these two variables decide instead).
# Heroku PostgreSQL uses a certificate that is not signed by a public CA: set
# DATABASE_SSL_REJECT_UNAUTHORIZED=false there (encrypted, but the server is not verified).
DATABASE_SSL=
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Integration tests only (npm run test:integration): a database on THIS machine whose name
# contains "test" and that differs from DATABASE_URL. Never point it at a shared database.
TEST_DATABASE_URL=
REQUIRE_INTEGRATION=

JWT_SECRET=
JWT_EXPIRATION=8h
REFRESH_TOKEN_EXPIRATION=30d
# Must be true when NODE_ENV=production, otherwise the server refuses to start.
COOKIE_SECURE=false

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=bridge-path-prod

# Admin file downloads stay blocked until virus scanning and a download provider exist.
# Setting this to true without a provider stops the server at startup.
FILE_DOWNLOAD_ENABLED=false

# Number of reverse proxies in front of the app (Heroku: 1). Leave 0 when not behind a proxy.
# Used for the client IP in rate limiting and audit logs. Must be an integer, never "true".
TRUST_PROXY=0

# Admin rate limits (in-memory, per server process). Window in ms, max requests per window.
# Login counts only failed attempts, per client IP.
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MS=900000
ADMIN_LOGIN_RATE_LIMIT_MAX=10
# All /admin requests, per client IP.
ADMIN_API_RATE_LIMIT_WINDOW_MS=60000
ADMIN_API_RATE_LIMIT_MAX=120
# Status changes and memo creation, per admin.
ADMIN_MUTATION_RATE_LIMIT_WINDOW_MS=60000
ADMIN_MUTATION_RATE_LIMIT_MAX=30
# Password change attempts, per admin.
ADMIN_PASSWORD_RATE_LIMIT_WINDOW_MS=900000
ADMIN_PASSWORD_RATE_LIMIT_MAX=5

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=
EMAIL_WORKER_ENABLED=false
EMAIL_WORKER_INTERVAL_MS=30000
EMAIL_WORKER_STALE_TIMEOUT_MS=300000

SUPPORT_EMAIL=contact@bridgepath.co.kr
SUPPORT_PHONE=02-0000-0000

LOG_LEVEL=info
SENTRY_DSN=
